# ==============================================================================
# BrightLoop - Git Ignore Configuration
# ==============================================================================
# Files and folders that should NOT be tracked in source control.

# Python compiled bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
env/
ENV/
.venv/

# Database & local secrets
db.sqlite3
db.sqlite3-journal
.env
.env.local

# Django media files uploaded during testing
media/

# IDE & Editor folders
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store
